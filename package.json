{
  "name": "forewright",
  "version": "0.1.0",
  "private": true,
  "description": "Local workspace that coordinates a CTO agent and specialist coding agents per project, through a terminal UI.",
  "type": "module",
  "bin": {
    "forewright": "dist/cli/main.js"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-gui.mjs && node -e \"const fs = require('node:fs'); fs.chmodSync('dist/cli/main.js', 0o755); fs.copyFileSync('src/providers/pty-helper.py', 'dist/providers/pty-helper.py')\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test --test-concurrency=1 --test-timeout=300000 \"dist/**/*.test.js\"",
    "start": "node dist/cli/main.js"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/headless": "6.0.0",
    "@xterm/xterm": "6.0.0",
    "ink": "^7.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "ink-testing-library": "^4.0.0",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@11.5.0",
  "optionalDependencies": {
    "node-pty": "1.1.0"
  }
}
