  "productName": "Forewright",
  "version": "0.1.0",
  "identifier": "dev.forewright.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
