{
  "name": "forewright",
  "version": "0.1.0",
  "private": true,
  "description": "Local workspace that coordinates a CTO agent and specialist coding agents per project, through a terminal UI.",
  "type": "module",
  "bin": {
    "forewright": "dist/cli/main.js"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json && node --test --test-concurrency=1 --test-timeout=300000 \"dist/**/*.test.js\"",
    "start": "node dist/cli/main.js"
  },
  "dependencies": {
    "ink": "^7.1.1",
    "react": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "ink-testing-library": "^4.0.0",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@11.5.0"
}
